import json
from pathlib import Path
from cryptography.fernet import Fernet

class SecureVault:
    """Manajer Vault Terenkripsi tingkat tinggi untuk menyimpan API Keys, Tokens, dan Private Keys."""
    
    def __init__(self, vault_path: str = "secrets.enc", key_path: str = "secret.key") -> None:
        self.vault_path = Path(vault_path)
        self.key_path = Path(key_path)
        self._cipher = Fernet(self._initialize_key())

    def _initialize_key(self) -> bytes:
        """Membuat kunci enkripsi secara otomatis jika belum tersedia, atau memuatnya."""
        if not self.key_path.exists():
            key = Fernet.generate_key()
            self.key_path.write_bytes(key)
        return self.key_path.read_bytes()

    def save(self, data: dict) -> None:
        """Menyimpan data dictionary ke dalam file secrets.enc dalam keadaan terenkripsi."""
        serialized_data = json.dumps(data).encode("utf-8")
        encrypted_data = self._cipher.encrypt(serialized_data)
        self.vault_path.write_bytes(encrypted_data)

    def load(self) -> dict:
        """Membaca dan mendekripsi kembali file secrets.enc menjadi format dictionary."""
        if not self.vault_path.exists():
            return {}
        
        encrypted_data = self.vault_path.read_bytes()
        decrypted_data = self._cipher.decrypt(encrypted_data)
        return json.loads(decrypted_data.decode("utf-8"))


if __name__ == "__main__":
    # Inisialisasi Vault
    vault = SecureVault()

    # Contoh data rahasia
    secret_data = {
        "API_KEY": "sk_live_abcdef123456789",
        "TOKEN": "Bearer eyJhbGciOiJIUzI1NiIs...",
        "PRIVATE_KEY": "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----"
    }

    # Menyimpan ke secrets.enc
    vault.save(secret_data)

    # Memuat kembali untuk verifikasi
    loaded_secrets = vault.load()
    print("Vault berhasil dimuat. Kunci yang tersimpan:", list(loaded_secrets.keys()))
